#!/bin/sh
# build_regex — compila fexlswi: Fexl + extension regex + motor de jotter.
#
# Los UNICOS binarios finales son bin/fexlswi y bin/fexlswi0 (mismo ELF con
# distinto nombre: el sufijo 0 evita cargar main.fxl).
#
#   1. compila type_regex.c -> obj/type_regex.bc (flags de lib_build)
#   2. recompila fexl.c con -DJOTTER_REGEX -> obj/fexl_regex.bc
#   3. llvm-link de TODOS los obj/*.bc + 7 modulos -> lib/fexlswi.bc
#   4. opt-21 LTO + clang dinamico musl -> bin/fexlswi / bin/fexlswi0
#
# Los 7 modulos del motor viven en regex/*.ll de este proyecto y se
# compilan a regex/build/*.bc con ./build.sh (opt con -mtriple).

set -e
. ./lib_build

CC=${FEXL_CC:-clang --target=x86_64-linux-musl}
OPTFLAGS="-c -emit-llvm ${FEXL_COPT:--Oz} -ffunction-sections -fdata-sections \
-fvisibility=hidden -fno-unwind-tables -fno-asynchronous-unwind-tables \
-fno-ident -fno-stack-protector -Wall -Werror -Wunused-parameter \
-Wdeclaration-after-statement ${FEXL_WARN:-} -I ."

echo "== 1. type_regex.bc / type_script.bc =="
run $CC $OPTFLAGS type_regex.c -o ../obj/type_regex.bc
run $CC $OPTFLAGS type_script.c -o ../obj/type_script.bc

echo "== 2. fexl.c con JOTTER_REGEX =="
run $CC $OPTFLAGS -DJOTTER_REGEX fexl.c -o ../obj/fexl_regex.bc

echo "== 3. modulos del motor (7 sin fsio) =="
RXDIR=../regex/build
RX_MODULES="regex_parser regex_compiler regex_abregex regex_thread \
regex_runner rx_query rx_runtime"
RX_BC=""
for m in $RX_MODULES; do
	bc="$RXDIR/$m.bc"
	if [ ! -e "$bc" ]; then
		echo >&2 "falta $bc: correr ./build.sh desde la raiz de fexlswi"
		exit 1
	fi
	RX_BC="$RX_BC $bc"
done

echo "== 4. llvm-link -> lib/fexlswi.bc =="
# todos los .bc de Fexl excepto el fexl.bc normal (se reemplaza por fexl_regex.bc)
FEXL_BC=""
for bc in ../obj/*.bc; do
	case "$bc" in
		*/fexl.bc|*/fexl_regex.bc|*/type_regex.bc|*/type_script.bc) continue ;;
	esac
	FEXL_BC="$FEXL_BC $bc"
done
run ${FEXL_LLLINK21:-llvm-link-21} $FEXL_BC ../obj/fexl_regex.bc \
	../obj/type_regex.bc ../obj/type_script.bc $RX_BC \
	-o ../lib/fexlswi.bc

# optimization pass sobre el bitcode fusionado (LTO) si el perfil lo pide
if [ -n "$FEXL_FUSE_OPT" ]; then
	run ${FEXL_OPT:-opt-21} -passes="$FEXL_FUSE_OPT" \
		../lib/fexlswi.bc -o ../lib/fexlswi.opt.bc
	mv ../lib/fexlswi.opt.bc ../lib/fexlswi.bc
fi

echo "== 5. binarios finales fexlswi y fexlswi0 =="
run $CC ${FEXL_LDFLAGS:--static -Oz -fuse-ld=lld -Wl,--gc-sections -s} \
	../lib/fexlswi.bc -lm -o ../bin/fexlswi
# termina en '0' => eval_script NO carga main.fxl: entorno limpio para swi.
# copia real, no symlink.
run cp ../bin/fexlswi ../bin/fexlswi0

echo "listos: ../bin/fexlswi, ../bin/fexlswi0"
